# Copy to .env and fill in real values before running docker compose up.

# Database (docker-compose's db service uses these same values to init Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=employee_agent
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/employee_agent

# JWT - generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-random-64-byte-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies - set COOKIE_SECURE=false only for local http:// development
COOKIE_SECURE=true
COOKIE_DOMAIN=

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# SMTP (alert emails to supervisors)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=employee-agent@example.com
SMTP_USE_TLS=true

# Scheduler cadence
AGGREGATION_INTERVAL_MINUTES=15
ALERT_EVALUATION_INTERVAL_MINUTES=5

ENVIRONMENT=development

# Seed script (scripts/seed_admin.py) - first Admin user
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin@123
SEED_ADMIN_FULL_NAME=Admin User
